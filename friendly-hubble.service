[Unit]
Description=8086 One-Pass Assembler & CPU Simulator Web Application
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/friendly-hubble
Environment="PATH=/home/ubuntu/friendly-hubble/venv/bin"
ExecStart=/home/ubuntu/friendly-hubble/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:5000 --timeout 60 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
